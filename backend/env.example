# Supabase backend configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHILOMATH_ENCRYPTION_KEY=YOUR_FERNET_KEY

# Frontend URLs allowed to call FastAPI.
# Add your Vercel frontend URL later, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional developer fallbacks. Logged-in users normally use their own saved keys.
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
GROK_MODEL=grok-4.3
