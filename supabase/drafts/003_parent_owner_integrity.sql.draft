-- Reviewed staging candidate: no data repair, ownership inference or backfill.
-- Original four FKs remain CASCADE / NO ACTION / NOT DEFERRABLE unchanged.
-- Execution acknowledgement, NOT independent project-identity proof.
-- The runner must verify the DSN, TLS and staging API before setting this GUC.
DO $target$
DECLARE target text := current_setting('philomath.batch4_target', true);
BEGIN
    IF current_user <> 'postgres' THEN
        RAISE EXCEPTION 'Batch 4 requires the reviewed administrative role';
    END IF;
    IF target = 'offline-local' AND current_database() = 'philomath_batch4_test'
       AND inet_client_addr() IS NULL THEN
        RETURN;
    END IF;
    IF target IS DISTINCT FROM 'tdiqzmaqvoynspmilwra'
       OR current_database() <> 'postgres' THEN
        RAISE EXCEPTION 'Batch 4 target is not explicitly verified staging';
    END IF;
END
$target$;
SET LOCAL lock_timeout = '2s';
SET LOCAL statement_timeout = '20s';

ALTER TABLE public.conversations ADD CONSTRAINT conversations_id_user_id_key UNIQUE (id,user_id);
-- The canonical message indexes contain no conversation prefix. This supports
-- parent checks and cascade lookups without adding a redundant user-only index.
CREATE INDEX messages_conversation_user_idx ON public.messages(conversation_id,user_id);
ALTER TABLE public.messages ADD CONSTRAINT messages_parent_owner_fkey
    FOREIGN KEY (conversation_id,user_id) REFERENCES public.conversations(id,user_id)
    MATCH SIMPLE ON DELETE CASCADE ON UPDATE NO ACTION NOT DEFERRABLE NOT VALID;
-- NOT VALID preserves inconsistent legacy rows. MATCH SIMPLE skips NULL keys;
-- triggers below enforce non-NULL ownership on future writes.
CREATE FUNCTION public.philomath_guard_conversation() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path = '' AS $$
BEGIN
    IF TG_OP='DELETE' THEN
        IF OLD.user_id IS NULL OR EXISTS (SELECT 1 FROM public.messages AS child
            WHERE child.conversation_id=OLD.id AND child.user_id IS DISTINCT FROM OLD.user_id) THEN
            RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Conversation ownership integrity rejected';
        END IF;
        RETURN OLD;
    END IF;
    IF NEW.user_id IS NULL OR (TG_OP='UPDATE' AND NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
        RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Conversation ownership integrity rejected';
    END IF;
    RETURN NEW;
END
$$;
CREATE TRIGGER philomath_conversation_ownership
    BEFORE INSERT OR UPDATE OR DELETE ON public.conversations
    FOR EACH ROW EXECUTE FUNCTION public.philomath_guard_conversation();
CREATE FUNCTION public.philomath_guard_message() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path = '' AS $$
BEGIN
    IF TG_OP='DELETE' THEN
        IF OLD.user_id IS NULL THEN
            RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Message ownership integrity rejected';
        END IF;
        RETURN OLD;
    END IF;
    IF NEW.user_id IS NULL OR NEW.conversation_id IS NULL
       OR (TG_OP='UPDATE' AND NEW.user_id IS DISTINCT FROM OLD.user_id) THEN
        RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Message ownership integrity rejected';
    END IF;
    PERFORM 1 FROM public.conversations AS parent
        WHERE parent.id=NEW.conversation_id AND parent.user_id=NEW.user_id FOR KEY SHARE;
    IF NOT FOUND THEN
        RAISE EXCEPTION USING ERRCODE='23503', MESSAGE='Message ownership integrity rejected';
    END IF;
    RETURN NEW;
END
$$;
CREATE TRIGGER philomath_message_ownership
    BEFORE INSERT OR UPDATE OR DELETE ON public.messages
    FOR EACH ROW EXECUTE FUNCTION public.philomath_guard_message();
REVOKE ALL ON FUNCTION public.philomath_guard_conversation(),public.philomath_guard_message()
    FROM PUBLIC,anon,authenticated;
-- Valid cascades continue. Cascades touching legacy NULL/inconsistent children
-- now fail atomically: stricter outcomes preserve records without rewriting FKs.
